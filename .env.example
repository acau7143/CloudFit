# CloudFit 환경 설정 예시
#
# 사용법: 이 파일을 복사해서 .env 로 만들고 값을 채운다.  (cp .env.example .env)
#   - .env 는 .gitignore 에 있으므로 커밋되지 않는다. 비밀번호/토큰을 이 파일에 직접 쓰지 말 것.
#   - 이 파일을 두는 위치: 서버 VM과 각 수집기 VM의 프로젝트 루트(CloudFit/.env).
#   - "필수"는 해당 컴포넌트를 쓸 때 반드시 채워야 한다. 빠지면 어떤 키가 빠졌는지
#     알려주고 종료한다 (기본값으로 조용히 넘어가지 않음).
#
# 어느 VM에 무엇이 필요한가:
#   서버 VM        : [서버/DB] [Slack] [예산]  (+ 그 VM에서 수집도 한다면 해당 클라우드 섹션)
#   AWS 수집 VM    : [공통] [AWS]
#   Azure 수집 VM  : [공통] [Azure]
#   GCP 수집 VM    : [공통] [GCP]

# ---------------------------------------------------------------- [공통] 수집기 → 서버
# 수집기가 데이터를 보낼 중앙 서버 주소. 서버와 같은 VM이면 생략 가능(기본값 http://localhost:8000).
SERVER_URL=http://서버-IP-또는-도메인:8000

# ---------------------------------------------------------------- [서버/DB] docker-compose
# 필수: docker-compose.yml 이 DB와 서버 컨테이너에 주입한다.
DB_PASSWORD=
DATABASE_URL=postgresql://finops:DB_PASSWORD값@localhost:5432/finops_db
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- [Slack]
# 미사용 리소스/예산 초과/이상탐지 알림용 Incoming Webhook. 비워두면 알림만 건너뛴다.
SLACK_WEBHOOK_URL=
# Slack 슬래시 명령(/slack/ask 등)을 쓸 때만 필요 (서버).
SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------- [예산] server/budget_alert.py
# 클라우드별 월 예산(USD). 비워두면 그 클라우드는 예산 검사를 건너뛴다.
BUDGET_AWS=
BUDGET_AZURE=
BUDGET_GCP=

# ---------------------------------------------------------------- [AWS] collectors/aws_*.py
# 인증: EC2 인스턴스 역할(IAM Role)을 쓴다. 키를 .env에 넣지 않는다.
# 필수
AWS_REGION=ap-northeast-2
AWS_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
# 선택 - CloudWatch Agent 가 내보내는 디스크 Dimension 과 정확히 일치해야 한다 (기본값 아래와 같음)
# AWS_DISK_DEVICE=nvme0n1p1
# AWS_DISK_FSTYPE=xfs

# ---------------------------------------------------------------- [GCP] collectors/gcp_*.py
# 인증: VM에 연결된 서비스 계정(ADC)을 쓴다. 키 파일을 .env에 넣지 않는다.
# 필수
GCP_PROJECT_ID=
GCP_ZONE=asia-northeast3-a
GCP_INSTANCE_NAME=
# 비용 수집(BigQuery billing export): 청구 계정 ID (예: 012345-6789AB-CDEF01)
GCP_BILLING_ACCOUNT_ID=
# 선택
# GCP_REGION=asia-northeast3     # 생략하면 GCP_ZONE 에서 자동 계산
# GCP_DISK_DEVICE=/dev/sda1      # Ops Agent disk/percent_used 지표의 device 라벨

# ---------------------------------------------------------------- [Azure] collectors/azure_*.py
# 필수 (서비스 프린시펄 인증)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_VM_NAME=
AZURE_LOG_WORKSPACE_ID=
# 선택 (기본값 koreacentral)
# AZURE_REGION=koreacentral
